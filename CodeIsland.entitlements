<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Remote AI conversation (v1.2.0): CloudKit private database -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.notchdeck</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!--
	  aps-environment is REQUIRED for CloudKit silent push (CKDatabaseSubscription /
	  CKQuerySubscription with shouldSendContentAvailable) to be delivered to this
	  Developer-ID signed app. Xcode only injects it automatically for App Store /
	  Ad-Hoc provisioning profiles; a manual `codesign` (build.sh) does NOT, so it
	  must be declared here or Remote Status push never arrives on the Mac.
	  Must match the CloudKit container environment the app actually uses:
	  `production` for the shipped default container, `development` only while
	  testing against the Dev CKContainer.
	-->
	<key>aps-environment</key>
	<string>production</string>
	<!--
	  NOTE: `codesign` does NOT expand build variables ($(TeamIdentifierPrefix)
	  etc.) — only the Xcode build system does. build.sh signs with codesign
	  directly, so the kvstore identifier is hardcoded to the actual Team ID
	  (2VBHV3VJ8N). Without expansion, CKContainer(identifier:) asserts
	  (SIGTRAP) at launch. Do NOT add com.apple.application-identifier here:
	  it is a provisioning-profile entitlement and AMFI kills Developer-ID
	  signed apps that carry it (SIGKILL at spawn).
	-->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>2VBHV3VJ8N.com.notchdeck.mac</string>
</dict>
</plist>
